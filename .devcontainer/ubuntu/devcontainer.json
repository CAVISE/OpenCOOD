{
  "build": {
    "args": {
      "USER": "devcontainer"
    },
    "context": "${localWorkspaceFolder}",
    "dockerfile": "${localWorkspaceFolder}/.devcontainer/ubuntu/Dockerfile"
  },
  "containerUser": "devcontainer",
  "name": "OpenCOOD DevContainer",
  "postCreateCommand": "python3 -m pip install --break-system-packages --no-deps -e ${containerWorkspaceFolder}",
  "runArgs": [
    "--shm-size=8g"
  ]
}
